{
  "name": "dungeon-atelier",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run build:core && npm run dev --workspace @dungeon-atelier/app",
    "build:core": "npm run build --workspace @dungeon-atelier/core",
    "build": "npm run build:core && npm run build --workspace @dungeon-atelier/app",
    "typecheck": "npm run typecheck --workspace @dungeon-atelier/core && npm run build:core && npm run typecheck --workspace @dungeon-atelier/app",
    "lint": "prettier --write . && npm run lint --workspace @dungeon-atelier/app",
    "lint:check": "prettier --check . && npm run lint:check --workspace @dungeon-atelier/app",
    "postinstall": "npm run build:core && npm run prepare:app --workspace @dungeon-atelier/app",
    "test": "npm run build:core && node --experimental-strip-types --test tests/*.test.mjs",
    "verify:stress": "npm run build:core && node scripts/stress.mjs",
    "verify:regressions": "npm run build:core && node --test tests/regressions.test.mjs",
    "verify:replay": "npm run build:core && node scripts/reproduce.mjs",
    "verify:browser": "node scripts/verify-browser.mjs",
    "verify:dimensional": "node scripts/verify-dimensional.mjs",
    "verify:foundation": "node scripts/verify-visual-foundation.mjs",
    "verify:masonry": "node scripts/verify-masonry.mjs",
    "verify:readability": "node scripts/verify-readability.mjs",
    "verify:floors": "node scripts/verify-floors.mjs",
    "verify:generated-floors": "node scripts/verify-generated-floors.mjs",
    "verify:cap-polish": "node scripts/verify-cap-polish.mjs",
    "verify:coping": "node scripts/verify-coping.mjs",
    "verify:chamfer": "node scripts/verify-chamfer.mjs",
    "verify:final-polish": "node scripts/verify-final-polish.mjs",
    "verify:stair-direction": "node scripts/verify-stair-direction.mjs",
    "verify:production-visuals": "node scripts/verify-production-visuals.mjs",
    "verify:production-details": "node scripts/verify-production-details.mjs",
    "verify:production-build": "node scripts/verify-production-build.mjs",
    "verify:production-placements": "node --experimental-strip-types scripts/verify-production-placements.mjs",
    "verify:foundation-staging": "node scripts/verify-foundation-staging.mjs",
    "preview:dimensional": "node scripts/render-dimensional-prototype.mjs"
  },
  "devDependencies": {
    "prettier": "^3.8.1",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": "^22.12 || ^24 || >=26"
  }
}
